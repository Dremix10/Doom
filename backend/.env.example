# Copy to backend/.env and fill in what you have. Everything is optional:
# with nothing set, the backend runs on SQLite with a deterministic policy and an
# in-app notification inbox — enough to build the app and run the simulator.

APP_NAME=Nudge

# Public URLs (used in the iPhone profile setup page and links).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8081

# --- Database ---
# Leave empty for local SQLite. For the Tiger Data challenge, point at Tiger Cloud:
# DATABASE_URL=postgresql+psycopg://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# --- Sensor (AdGuard Home on the Vultr box) ---
# Empty ADGUARD_URL disables the DNS sensor (simulator still works).
ADGUARD_URL=
ADGUARD_USER=admin
ADGUARD_PASS=
# The DoH endpoint the iPhone profile points at; the per-user ClientID is appended.
DOH_BASE_URL=https://dns.YOURDOMAIN.com/dns-query

# --- Agent ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Demo mode compresses time so the nudge->escalate arc fits a 2-minute demo.
DEMO_MODE=0
DEMO_TIME_SCALE=20

# --- Delivery ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Web Push (generate with: python -m app.tools.vapid). Optional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@yourdomain.com

INTERNAL_TOKEN=change-me
